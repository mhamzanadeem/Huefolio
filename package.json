{
  "name": "huefolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env build.mjs && node --env-file-if-exists=.env serve.mjs --dist",
    "start": "npm run dev",
    "build": "node --env-file-if-exists=.env build.mjs",
    "build:vercel": "node --env-file-if-exists=.env build.mjs --vercel",
    "backend": "npm --prefix backend start"
  },
  "engines": { "node": ">=22.12.0" }
}
