PORT=10000
NODE_ENV=development
YOUCAM_INTEGRATION_ENABLED=false
YOUCAM_API_KEY=
# Current /s2s/v2.0 endpoints send only the API key as Bearer auth.
# A separate console secret is NOT used or transmitted by this integration.
YOUCAM_SECRET_KEY=
# Conservative application cap. Provider maximum: 250 per 300 seconds per IP/token.
YOUCAM_REQUEST_LIMIT=200
# Exact signed-upload DNS hosts verified with the provider; no wildcard/scheme/path.
YOUCAM_UPLOAD_HOSTS=
# Use * for all browser origins, or a comma-separated list of exact origins.
FRONTEND_ORIGINS=*
# Random server-only administration secret, at least 32 characters.
HUEFOLIO_ADMIN_TOKEN=
# Automatic budget initialization on startup. Set true only for optional manual mode.
HUEFOLIO_RECONCILE_ON_START=false
# Per-process allowance, not the provider account balance; resets on server restart.
HUEFOLIO_API_BUDGET_UNITS=800
HUEFOLIO_MAX_CONCURRENT_ANALYSES=2
